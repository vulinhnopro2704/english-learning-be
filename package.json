    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/throttler": "^6.4.0",
    "@open-spaced-repetition/binding": "^0.6.1",
    "@open-spaced-repetition/binding-wasm32-wasi": "^0.6.1",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@scalar/nestjs-api-reference": "^1.2.33",
    "bcryptjs": "^3.0.3",
    "chalk": "^5.4.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "fsrs-rs-nodejs": "^0.9.1",
    "ioredis": "^5.10.1",
    "ollama": "^0.6.4",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.13.0",
    "prisma": "^7.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-fsrs": "^6.0.0",
    "uuid": "^10.0.0",
