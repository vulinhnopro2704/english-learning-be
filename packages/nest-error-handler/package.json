{
  "name": "@english-learning/nest-error-handler",
  "version": "0.1.5",
  "description": "Reusable NestJS exception filter and validation pipe for English Learning platform",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@english-learning/api-error-types": "^0.1.5",
    "@english-learning/logger": "^0.1.5",
    "@nestjs/common": "^12.3.2",
    "class-validator": "^0.15.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.2"
  }
}
