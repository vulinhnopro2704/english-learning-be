{
  "name": "@english-learning/nest-api-docs",
  "version": "0.1.5",
  "description": "Reusable Swagger/OpenAPI and Scalar UI setup for English Learning NestJS services",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@english-learning/api-error-types": "^0.1.5",
    "@nestjs/common": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@scalar/nestjs-api-reference": "^1.2.33"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.2"
  }
}
